# Gradle caches and build output
.gradle/
**/build/
# Source packages may legitimately be named "build"; those must stay tracked.
!src/**/build/

# Local Minecraft runtime and migration workspace
/run/
/.migration/
/data/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
/out/

# Logs and crash output
*.log
*.log.gz
logs/
crash-reports/
hs_err_pid*
replay_pid*

# Compiled and packaged files
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Gradle Wrapper is required to build a fresh clone
!gradle/wrapper/gradle-wrapper.jar

# OS and editor files
.DS_Store
Thumbs.db
*~

# Generated resource caches only; generated resources themselves are required
**/.cache/

# Agent / tooling scratch artifacts (must never be committed)
.codex-artifacts/
.tmp-*/
.tmp-*
.ref-*/
codemcmod*.tmp-javac-out/
